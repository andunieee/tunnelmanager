import { LineEdit } from "std-widgets.slint";
import { State, Logic, PeerRow } from "globals.slint";
import {
    Theme, Card, HintText, StatusText, SectionHeader, PageTitle, Avatar,
    Icons, PrimaryButton, SecondaryButton, GhostButton, ScrollView,
} from "components.slint";

component SuggestionRow inherits Rectangle {
    in property <PeerRow> entry;

    border-radius: Theme.radius;
    background: root.entry.is-request ? Theme.accent-soft : Theme.inset-bg;
    border-width: 1px;
    border-color: root.entry.is-request ? #a8d2fa : Theme.border;

    HorizontalLayout {
        padding: Theme.space-2 + 2px;
        padding-left: Theme.space-3;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;
            Avatar {
                initials: root.entry.initials;
                size: 34px;
                tint: root.entry.is-request ? Theme.accent : Theme.chip-bg-hover;
                ink: root.entry.is-request ? white : Theme.text;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.entry.name;
                color: Theme.text-strong;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.entry.detail;
                color: root.entry.is-request ? Theme.accent-text : Theme.text-muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
        }

        if root.entry.is-request: HorizontalLayout {
            spacing: Theme.space-1;
            VerticalLayout {
                alignment: center;
                GhostButton { label: "Decline"; clicked => { Logic.decline-suggestion(root.entry.endpoint-id); } }
            }
            VerticalLayout {
                alignment: center;
                PrimaryButton { label: "Accept"; clicked => { Logic.accept-suggestion(root.entry.endpoint-id); } }
            }
        }
        if root.entry.is-suggestion: VerticalLayout {
            alignment: center;
            SecondaryButton {
                label: "Pair";
                clicked => { Logic.accept-suggestion(root.entry.endpoint-id); }
            }
        }
    }
}

export component AddPeerPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.space-4;
            alignment: start;

            PageTitle { title: "Add a peer"; }

            // Outcome of the last pairing attempt (address or nearby).
            if !State.pairing-busy && State.pairing-status != "": Rectangle {
                border-radius: Theme.radius;
                background: State.pairing-error ? Theme.error-soft : Theme.success-soft;
                HorizontalLayout {
                    padding: Theme.space-3;
                    padding-left: Theme.space-4;
                    StatusText { label: State.pairing-status; error: State.pairing-error; }
                }
            }

            // Camera viewfinder while scanning a peer's QR code.
            if State.scanning: Card {
                VerticalLayout {
                    padding: Theme.card-padding;
                    spacing: Theme.space-3;

                    SectionHeader { label: "Scan a QR code"; icon: Icons.qr; }
                    HintText { label: "Point the camera at the QR code on the other device."; }
                    Rectangle {
                        height: self.width;
                        border-radius: Theme.radius;
                        background: Theme.inset-bg;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: State.scan-frame;
                            image-fit: cover;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        GhostButton {
                            label: "Cancel";
                            clicked => { Logic.scan-cancel(); }
                        }
                    }
                }
            }

            // Nearby devices + inbound requests
            Card {
                VerticalLayout {
                    padding: Theme.card-padding;
                    spacing: Theme.space-3;

                    SectionHeader { label: "Nearby and requests"; icon: Icons.nearby; }
                    if State.nearby-note != "": HintText { label: State.nearby-note; }
                    if State.suggestions.length == 0: Rectangle {
                        height: 56px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            text: "Looking for devices…";
                            color: Theme.text-faint;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    for node in State.suggestions: SuggestionRow { entry: node; }
                }
            }

            // Paste an address
            Card {
                VerticalLayout {
                    padding: Theme.card-padding;
                    spacing: Theme.space-3;

                    SectionHeader { label: "Connect with an address"; icon: Icons.link; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        LineEdit {
                            text <=> State.add-ticket-input;
                            placeholder-text: "Pairing address";
                            horizontal-stretch: 1;
                            accepted => { Logic.pair-with-pasted(); }
                        }
                        PrimaryButton {
                            label: State.pairing-busy ? "Connecting…" : "Connect";
                            enabled: State.add-ticket-input != "" && !State.pairing-busy;
                            clicked => { Logic.pair-with-pasted(); }
                        }
                    }
                    if State.touch && !State.scanning: HorizontalLayout {
                        alignment: start;
                        SecondaryButton {
                            label: "Scan QR code";
                            icon: Icons.qr;
                            enabled: !State.pairing-busy;
                            clicked => { Logic.scan-qr(); }
                        }
                    }
                }
            }

            // Our own address
            Card {
                VerticalLayout {
                    padding: Theme.card-padding;
                    spacing: Theme.space-3;

                    SectionHeader { label: "Your address"; icon: Icons.device; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: Theme.radius-sm + 2px;
                            background: Theme.inset-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            min-height: Theme.control-height;

                            HorizontalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-3;
                                Text {
                                    text: State.my-ticket == "" ? "Available once connected…" : State.my-ticket;
                                    color: State.my-ticket == "" ? Theme.text-faint : Theme.text;
                                    font-family: "monospace";
                                    font-size: Theme.font-xs;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        SecondaryButton {
                            label: "Copy";
                            icon: Icons.copy;
                            enabled: State.my-ticket != "";
                            clicked => { Logic.copy-my-ticket(); }
                        }
                        SecondaryButton {
                            label: State.show-qr ? "Hide QR" : "QR code";
                            icon: Icons.qr;
                            enabled: State.my-ticket != "";
                            clicked => { Logic.toggle-my-qr(); }
                        }
                    }
                    if State.show-qr: HorizontalLayout {
                        alignment: center;
                        Image {
                            source: State.my-qr;
                            width: min(240px, root.width - 2 * Theme.page-padding - 2 * Theme.card-padding);
                            height: self.width;
                            image-rendering: pixelated;
                        }
                    }
                }
            }
        }
    }
}
