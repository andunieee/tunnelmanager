import { LineEdit, TextEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { State, Logic } from "globals.slint";
import {
    Theme, Card, PageTitle, HintText, StatusText, FieldLabel, Divider,
    SectionHeader, Icons, PrimaryButton, SecondaryButton, GhostButton, ScrollView,
} from "components.slint";

// Label + control stacked, with an optional hint underneath.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 6px;

    FieldLabel { label: root.label; }
    @children
    if root.hint != "": HintText { label: root.hint; font-size: Theme.font-xs; }
}

component SettingsCard inherits Card {
    in property <string> title;
    in property <string> description;
    in property <image> icon;

    VerticalLayout {
        padding: Theme.card-padding + 2px;
        spacing: Theme.space-4;

        VerticalLayout {
            spacing: Theme.space-1;
            SectionHeader { label: root.title; icon: root.icon; }
            if root.description != "": HintText { label: root.description; }
        }
        @children
    }
}

export component SettingsPage inherits Rectangle {
    ScrollView {
        HorizontalLayout {
            alignment: start;
            padding: Theme.page-padding;

            VerticalLayout {
                // Comfortable reading width on wide windows.
                preferred-width: 680px;
                max-width: 680px;
                horizontal-stretch: 1;
                spacing: Theme.space-4;
                alignment: start;

                PageTitle { title: "Settings"; }

                SettingsCard {
                    title: "This device";
                    icon: Icons.device;

                    if !State.name-editing: HorizontalLayout {
                        spacing: Theme.space-2;
                        Text {
                            text: State.my-name;
                            color: Theme.text;
                            font-size: Theme.font-sm;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        GhostButton {
                            label: "Edit";
                            icon: Icons.edit;
                            clicked => {
                                State.name-input = State.my-name;
                                State.name-editing = true;
                            }
                        }
                    }
                    if State.name-editing: HorizontalLayout {
                        spacing: Theme.space-2;
                        name-field := LineEdit {
                            text <=> State.name-input;
                            placeholder-text: "Device name";
                            horizontal-stretch: 1;
                            init => { self.focus(); }
                            accepted => { Logic.rename-self-name(); }
                        }
                        PrimaryButton {
                            label: "Save";
                            clicked => {
                                // Losing focus commits the keyboard's composing
                                // text on Android; `name-input` lacks it until then.
                                name-field.clear-focus();
                                Logic.rename-self-name();
                            }
                        }
                        GhostButton {
                            label: "Cancel";
                            clicked => {
                                name-field.clear-focus();
                                State.name-editing = false;
                            }
                        }
                    }
                }

                SettingsCard {
                    title: "Received files";
                    icon: Icons.folder;

                    // The folder picker is desktop-only; on Android received
                    // files land in Download/flipflop/<peer>/.
                    if !State.touch: Field {
                        label: "Save to";
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Theme.radius-sm + 2px;
                                background: Theme.inset-bg;
                                border-width: 1px;
                                border-color: Theme.border;
                                min-height: Theme.control-height;
                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-3;
                                    Text {
                                        text: State.downloads-dir;
                                        color: Theme.text;
                                        font-size: Theme.font-sm;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            SecondaryButton { label: "Browse…"; icon: Icons.folder; clicked => { Logic.pick-downloads-dir(); } }
                        }
                    }
                    CheckBox {
                        text: "Keep a transfer history";
                        checked <=> State.history-enabled;
                    }
                }

                SettingsCard {
                    title: "Privacy";
                    icon: Icons.shield;

                    ComboBox {
                        model: ["Everyone nearby", "Paired devices only", "Nobody (hidden)"];
                        current-index <=> State.discoverability;
                    }
                }

                SettingsCard {
                    title: "Relay";
                    icon: Icons.relay;

                    ComboBox {
                        model: ["Default (n0 public relays)", "Disabled (direct connections only)", "Custom relays"];
                        current-index <=> State.relay-mode;
                    }
                    if State.relay-mode == 2: Field {
                        label: "Relay URLs";
                        TextEdit {
                            text <=> State.relay-urls;
                            height: 72px;
                            wrap: no-wrap;
                        }
                    }
                    if State.relay-mode == 2: Field {
                        label: "Auth token (optional)";
                        LineEdit {
                            text <=> State.relay-token;
                            input-type: password;
                            placeholder-text: "Token";
                        }
                    }
                    if State.relay-mode == 2: Field {
                        label: "If the relay is unreachable";
                        ComboBox {
                            model: ["Fail the transfer (strict)", "Fall back to public relays"];
                            current-index <=> State.relay-fallback;
                        }
                    }
                    if State.relay-mode != 1: HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        SecondaryButton {
                            label: State.relay-testing ? "Testing…" : "Test connection";
                            enabled: !State.relay-testing;
                            clicked => { Logic.test-relay(); }
                        }
                        SecondaryButton { label: "Show status"; clicked => { Logic.check-relay-status(); } }
                    }
                    if State.relay-test-status != "": StatusText {
                        label: State.relay-test-status;
                        error: State.relay-test-failed;
                    }
                    if State.relay-status != "": StatusText {
                        label: State.relay-status;
                        error: State.relay-status-failed;
                    }
                }

                SettingsCard {
                    title: "Discovery";
                    icon: Icons.globe;

                    ComboBox {
                        model: ["Default (n0)", "Custom pkarr relay"];
                        current-index <=> State.discovery-mode;
                    }
                    if State.discovery-mode == 1: Field {
                        label: "pkarr relay URL";
                        LineEdit {
                            text <=> State.discovery-pkarr-url;
                            placeholder-text: "https://dns.example.com/pkarr";
                        }
                    }
                    if State.discovery-mode == 1: Field {
                        label: "DNS origin (optional)";
                        LineEdit {
                            text <=> State.discovery-dns-origin;
                            placeholder-text: "example.com";
                        }
                    }
                    if State.discovery-mode == 1: HorizontalLayout {
                        alignment: start;
                        SecondaryButton {
                            label: State.discovery-testing ? "Testing…" : "Test connection";
                            enabled: !State.discovery-testing;
                            clicked => { Logic.test-discovery(); }
                        }
                    }
                    if State.discovery-test-status != "": StatusText {
                        label: State.discovery-test-status;
                        error: State.discovery-test-failed;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-3;
                    alignment: start;
                    padding-bottom: Theme.space-4;
                    PrimaryButton {
                        label: "Save settings";
                        clicked => { Logic.save-settings(); }
                    }
                    if State.settings-status != "": StatusText {
                        label: State.settings-status;
                        error: State.settings-failed;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
