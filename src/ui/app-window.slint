import { State, Logic, PeerRow } from "globals.slint";
import { Theme, Dot, Avatar, Overline, Icon, Icons, LogoMark, ScrollView } from "components.slint";
import { PeerPage } from "peer-page.slint";
import { PeersListPage } from "peers-list-page.slint";
import { AddPeerPage } from "add-peer-page.slint";
import { SettingsPage } from "settings-page.slint";

export { State, Logic }

// Sidebar navigation entry (Settings, Add peer).
component SideButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    in property <bool> accent;
    callback clicked;

    height: 36px;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-soft
        : ta.pressed ? Theme.chip-bg-hover
        : ta.has-hover ? Theme.chip-bg
        : transparent;
    animate background { duration: 90ms; }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2 + 2px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 18px;
                tint: root.accent || root.active ? Theme.accent-text : Theme.text-muted;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text-strong : root.accent ? Theme.accent-text : Theme.text;
            font-size: Theme.font-md;
            font-weight: root.active || root.accent ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component PeerButton inherits Rectangle {
    in property <PeerRow> peer;
    property <bool> selected: State.page == "peer" && State.selected-id == root.peer.endpoint-id;

    height: 44px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent-soft
        : ta.pressed ? Theme.chip-bg-hover
        : ta.has-hover ? Theme.chip-bg
        : transparent;
    animate background { duration: 90ms; }

    ta := TouchArea {
        clicked => {
            Logic.select-peer(root.peer.endpoint-id);
            State.page = "peer";
            Logic.page-changed("peer");
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-3;
        spacing: Theme.space-2 + 2px;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            Avatar {
                initials: root.peer.initials;
                size: 28px;
                show-presence: true;
                online: root.peer.online;
            }
        }
        Text {
            text: root.peer.name;
            color: root.selected ? Theme.text-strong : Theme.text;
            font-size: Theme.font-md;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // In-flight transfer markers.
        if root.peer.sending: VerticalLayout {
            alignment: center;
            Icon { source: Icons.arrow-up; size: 15px; tint: Theme.warn; }
        }
        if root.peer.receiving: VerticalLayout {
            alignment: center;
            Icon { source: Icons.arrow-down; size: 15px; tint: Theme.info; }
        }
    }
}

// Bottom navigation entry (compact layout): icon in an "active" pill over
// the label, with an optional count badge.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <image> icon;
    in property <int> badge;
    property <bool> active: State.page == root.key;

    ta := TouchArea {
        clicked => {
            // Re-tapping Peers from a peer's page returns to the list.
            if root.key == "peer" {
                State.peer-open = false;
            }
            State.page = root.key;
            Logic.page-changed(root.key);
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.accent-soft
                    : ta.pressed ? Theme.chip-bg : transparent;
                animate background { duration: 120ms; }

                Icon {
                    source: root.icon;
                    size: 22px;
                    tint: root.active ? Theme.accent-text : Theme.text-muted;
                }
                if root.badge > 0: Rectangle {
                    x: parent.width / 2 + 4px;
                    y: 0px;
                    height: 16px;
                    width: max(16px, badge-text.preferred-width + 8px);
                    border-radius: 8px;
                    background: Theme.accent;
                    badge-text := Text {
                        text: root.badge;
                        color: white;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text-strong : Theme.text-muted;
            font-size: Theme.font-xs;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
        }
    }
}

// "Connecting…" / own name, with a presence dot.
component NodeStatus inherits HorizontalLayout {
    spacing: 6px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Dot { online: State.node-ready; size: 7px; }
    }
    Text {
        text: !State.node-ready ? "Connecting…"
            : State.my-name == "" ? "Online" : State.my-name;
        color: State.node-ready ? Theme.text-muted : Theme.warn;
        font-size: Theme.font-xs;
        overflow: elide;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "flipflop";
    background: Theme.window-bg;
    default-font-size: Theme.font-md;

    // On phones the OS gives us a small window; don't force desktop sizes.
    preferred-width: State.touch ? 360px : 960px;
    preferred-height: State.touch ? 720px : 660px;
    min-width: State.touch ? 0px : 760px;
    min-height: State.touch ? 0px : 520px;

    // Single-pane layout (no sidebar) with a bottom nav. Driven purely by
    // State.compact (Rust): binding it to the window width creates a layout
    // binding loop, and the desktop window enforces min-width anyway.
    property <bool> compact: State.compact;

    // System bars drawn over the window (Android is edge-to-edge). The
    // preview-* values stand in for them in headless screenshots.
    in property <length> preview-inset-top;
    in property <length> preview-inset-bottom;
    property <length> inset-top: max(root.safe-area-insets.top, root.preview-inset-top);
    property <length> inset-bottom: max(root.safe-area-insets.bottom, root.preview-inset-bottom);
    // Compact: a peer's own screen is showing (it still exists).
    property <bool> peer-screen: State.peer-open && State.selected-name != "";

    // Android Back: peer screen → peer list → Peers tab → background.
    // Unhandled, Android would finish the activity (and the process).
    back-handler := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text != Key.Back {
                return reject;
            }
            if State.rename-mode {
                Logic.rename-peer-cancel();
            } else if root.compact && State.page == "peer" && root.peer-screen {
                State.peer-open = false;
            } else if State.page != "peer" {
                State.page = "peer";
                Logic.page-changed("peer");
            } else {
                Logic.back-at-root();
            }
            accept
        }

    VerticalLayout {
        // Compact app bar (phones), under the status bar.
        if root.compact: Rectangle {
            height: root.inset-top + 60px;
            background: Theme.window-bg;

            HorizontalLayout {
                padding-top: root.inset-top;
                padding-left: Theme.page-padding;
                padding-right: Theme.page-padding;
                spacing: Theme.space-3;

                VerticalLayout {
                    alignment: center;
                    LogoMark { size: 34px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "flipflop";
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        color: Theme.text-strong;
                    }
                    NodeStatus { }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        HorizontalLayout {
            // Sidebar: desktop + wide tablets only.
            if !root.compact: Rectangle {
                width: 240px;
                background: Theme.sidebar-bg;

                VerticalLayout {
                    padding: Theme.space-3;
                    padding-top: Theme.space-4;
                    spacing: Theme.space-1;

                    // App header
                    HorizontalLayout {
                        padding-left: Theme.space-1;
                        padding-bottom: Theme.space-3;
                        spacing: Theme.space-2 + 2px;

                        LogoMark { size: 32px; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "flipflop";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.text-strong;
                            }
                            NodeStatus { }
                        }
                    }

                    SideButton {
                        label: "Add peer";
                        icon: Icons.add-peer;
                        accent: true;
                        active: State.page == "add-peer";
                        clicked => {
                            State.page = "add-peer";
                            Logic.page-changed("add-peer");
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        padding-top: Theme.space-4;
                        padding-bottom: Theme.space-1;
                        Overline { label: "PEERS"; horizontal-stretch: 1; }
                        if State.peers.length > 0: Text {
                            text: State.presence-label;
                            color: Theme.text-faint;
                            font-size: Theme.font-xs;
                        }
                    }

                    if State.peers.length == 0: HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        Text {
                            text: "No peers yet. Add one to start sending.";
                            color: Theme.text-faint;
                            font-size: Theme.font-sm;
                            wrap: word-wrap;
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for peer in State.peers: PeerButton { peer: peer; }
                        }
                    }

                    SideButton {
                        label: "Settings";
                        icon: Icons.settings;
                        active: State.page == "settings";
                        clicked => {
                            State.page = "settings";
                            Logic.page-changed("settings");
                        }
                    }
                }
            }
            if !root.compact: Rectangle {
                width: 1px;
                background: Theme.border;
            }

            // Content
            Rectangle {
                horizontal-stretch: 1;
                // Phones: the peer list, or one peer's own screen.
                if State.page == "peer" && (!root.compact || root.peer-screen): PeerPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "peer" && root.compact && !root.peer-screen: PeersListPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "add-peer": AddPeerPage {
                    width: 100%;
                    height: 100%;
                }
                if State.page == "settings": SettingsPage {
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Bottom nav on compact layouts (phones): thumb-reachable, larger
        // hit targets than the desktop sidebar.
        // Extends under the system navigation bar.
        if root.compact: Rectangle {
            height: 68px + root.inset-bottom;
            background: Theme.sidebar-bg;
            border-width: 0;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-bottom: root.inset-bottom;
                TabButton { label: "Peers"; key: "peer"; icon: Icons.peers; badge: State.outbox-count; }
                TabButton { label: "Add peer"; key: "add-peer"; icon: Icons.add-peer; }
                TabButton { label: "Settings"; key: "settings"; icon: Icons.settings; }
            }
        }
    }
    }

    // Desktop toast (Android shows native toasts instead). Click to dismiss;
    // Rust clears it after a few seconds.
    if State.toast-text != "": Rectangle {
        width: min(toast-label.preferred-width + 40px, root.width - 48px);
        height: toast-label.preferred-height + 24px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (root.compact ? 84px + root.inset-bottom : 24px);
        border-radius: Theme.radius;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: State.toast-error ? #f7b8ba : Theme.border-strong;
        drop-shadow-color: #1e5a8a40;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;

        // Tone stripe on the left edge.
        Rectangle {
            x: 0;
            width: 4px;
            border-top-left-radius: Theme.radius;
            border-bottom-left-radius: Theme.radius;
            background: State.toast-error ? Theme.error : Theme.accent;
        }
        toast-label := Text {
            x: 22px;
            y: 12px;
            width: parent.width - 40px;
            text: State.toast-text;
            color: Theme.text-strong;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }
        TouchArea {
            clicked => { State.toast-text = ""; }
            mouse-cursor: pointer;
        }
    }
}
